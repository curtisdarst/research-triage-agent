# Copy this file to .env and fill in your own values. Never commit .env.
# No API keys or long-lived credentials are used by this project — auth is via
# Application Default Credentials (run `gcloud auth application-default login`).

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Separate from GCP_REGION: BigQuery and Cloud Run stay pinned to
# GCP_REGION, but gemini-3.7-flash and gemini-3.1-pro-preview both 404 in
# us-central1 (and every other region we tried) and only work via the
# "global" Vertex endpoint. Only override this if a future model needs a
# specific region instead.
MODEL_REGION=global

BQ_DATASET=research_triage
BQ_TABLE=papers

# Model IDs are config, not hardcoded, so they can be upgraded without a code change.
# gemini-3.1-pro-preview is preview-tier, not GA (no stable Gemini 3.x Pro
# exists yet as of 2026-08-15); gemini-2.5-pro is the fallback if you want
# stable-only. See README "Note on naming" / "Why tiered models".
MODEL_ORCHESTRATOR=gemini-3.7-flash
MODEL_SYNTHESIS=gemini-3.1-pro-preview
MODEL_VALIDATION=gemini-3.7-flash
MODEL_EMBEDDING=gemini-embedding-001
# Used only by eval/run_eval.py — a deliberately stronger/independent check
# on validate()'s per-claim verdicts, not a repeat of the same call.
MODEL_JUDGE=gemini-3.1-pro-preview
